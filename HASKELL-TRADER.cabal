cabal-version:      3.0

name:               HASKELL-TRADER
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             thefakeblue
maintainer:         122709556+thefakeblue@users.noreply.github.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

executable HASKELL-TRADER
    import:           warnings
    main-is:          Main.hs
    other-modules:
        Backtest
      , Strategies
      , Strategies.Simple
      , Strategies.Momentum
      , Strategies.MeanReversion
      , Strategies.RangeBreakout
      , Strategies.RSI
      , Strategies.MA
      , Strategies.StatefulRunner
      , Strategies.EmaReclaim
    build-depends:    base ^>=4.18.3.0, network, bytestring, time, containers, directory
    hs-source-dirs:   app
    default-language: Haskell2010

executable fetch-data
    import:           warnings
    main-is:          fetchdata.hs
    other-modules:
        Backtest
      , Strategies
      , Strategies.Simple
      , Strategies.Momentum
      , Strategies.MeanReversion
      , Strategies.RangeBreakout
      , Strategies.RSI
      , Strategies.MA
      , Strategies.StatefulRunner
      , Strategies.EmaReclaim
    build-depends:    base ^>=4.18.3.0, network, bytestring, time, containers, directory
    hs-source-dirs:   app
    default-language: Haskell2010

executable csv-replay
    import:           warnings
    main-is:          CsvReplay.hs
    other-modules:
        Backtest
      , Strategies
      , Strategies.Simple
      , Strategies.Momentum
      , Strategies.MeanReversion
      , Strategies.RangeBreakout
      , Strategies.RSI
      , Strategies.MA
      , Strategies.StatefulRunner
      , Strategies.EmaReclaim
    build-depends:    base ^>=4.18.3.0, time, containers, directory
    hs-source-dirs:   app
    default-language: Haskell2010
